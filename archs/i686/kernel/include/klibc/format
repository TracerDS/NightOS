    namespace detail {
        template <typename CharT, typename Context>
        constexpr void vformat_to_impl(
            std::basic_string_view<CharT> fmt,
            Context& ctx,
            basic_format_args<Context> args
        ) {
            auto out = ctx.out();

            const CharT* it = fmt.data();
            const CharT* last = fmt.data() + fmt.size();
            std::size_t autoIdx = 0;
            bool autoUsed = false, manualUsed = false;

            while (it != last) {
                CharT c = *it;

                if (c != CharT('{') && c != CharT('}')) {
                    *out++ = c;
                    ++it;
                    continue;
                }
                if (c == CharT('}')) {
                    assert(it + 1 != last && *(it + 1) == CharT('}') &&
                        "klibc::format: unmatched '}' in format string");
                    *out++ = CharT('}');
                    it += 2;
                    continue;
                }

                ++it; // consume '{'
                assert(it != last && "klibc::format: unterminated '{' in format string");
                if (*it == CharT('{')) {
                    *out++ = CharT('{');
                    ++it;
                    continue;
                }

                std::size_t argId;
                if (*it >= CharT('0') && *it <= CharT('9')) {
                    std::size_t id = 0;
                    while (it != last && *it >= CharT('0') && *it <= CharT('9')) {
                        id = id * 10 + static_cast<std::size_t>(*it - CharT('0'));
                        ++it;
                    }
                    argId = id;
                    manualUsed = true;
                    assert(!autoUsed && "klibc::format: cannot mix manual and automatic argument indexing");
                } else {
                    argId = autoIdx++;
                    autoUsed = true;
                    assert(!manualUsed && "klibc::format: cannot mix manual and automatic argument indexing");
                }

                std::basic_string_view<CharT> spec;
                if (it != last && *it == CharT(':')) {
                    ++it;
                    const CharT* specBegin = it;
                    while (it != last && *it != CharT('}')) ++it;
                    spec = std::basic_string_view<CharT>(specBegin, static_cast<std::size_t>(it - specBegin));
                }
                assert(it != last && *it == CharT('}') && "klibc::format: expected '}' in format string");
                ++it;

                ctx.advance_to(out);
                basic_format_arg<Context> arg = args.get(argId);
                assert(static_cast<bool>(arg) && "klibc::format: argument index out of range");
                arg.format(spec, ctx);
                out = ctx.out();
            }

            ctx.advance_to(out);
        }
    }

    // ==================== public API ====================
    template <typename OutputIt>
    struct format_to_n_result {
        OutputIt out;
        std::iter_difference_t<OutputIt> size;
    };

    template <typename OutputIt, typename CharT>
    constexpr OutputIt vformat_to(
        OutputIt out,
        std::basic_string_view<CharT> fmt,
        format_args_t<OutputIt, CharT> args
    ) noexcept {
        basic_format_context<OutputIt, CharT> ctx(out, args);
        detail::vformat_to_impl<CharT>(fmt, ctx, args);
        return ctx.out();
    }

    template <typename OutputIt, typename... Args>
   constexpr OutputIt format_to(
        OutputIt out,
        format_string<Args...> fmt,
        Args&&... args
    ) noexcept {
        using Context = basic_format_context<OutputIt, char>;
        auto store = detail::make_format_args_store<Context>(args...);
        basic_format_args<Context> fargs(store);
        Context ctx(out, fargs);
        detail::vformat_to_impl<char>(fmt.get(), ctx, fargs);
        return ctx.out();
    }

    template <typename OutputIt, typename... Args>
    constexpr format_to_n_result<OutputIt> format_to_n(
        OutputIt out,
        std::iter_difference_t<OutputIt> n,
        format_string<Args...> fmt,
        Args&&... args
    ) noexcept {
        using Trunc = detail::truncating_iterator<OutputIt, char>;
        using Context = basic_format_context<Trunc, char>;
        auto store = detail::make_format_args_store<Context>(args...);
        basic_format_args<Context> fargs(store);
        Trunc trunc(out, n < 0 ? 0 : static_cast<std::size_t>(n));
        Context ctx(trunc, fargs);
        detail::vformat_to_impl<char>(fmt.get(), ctx, fargs);
        auto result = ctx.out();
        return { result.base(), static_cast<std::iter_difference_t<OutputIt>>(result.count()) };
    }

    template <typename... Args>
    constexpr std::size_t formatted_size(
        format_string<Args...> fmt,
        Args&&... args
    ) noexcept {
        using Counter = detail::counting_iterator<char>;
        using Context = basic_format_context<Counter, char>;
        auto store = detail::make_format_args_store<Context>(args...);
        basic_format_args<Context> fargs(store);
        std::size_t n = 0;
        Counter counter(&n);
        Context ctx(counter, fargs);
        detail::vformat_to_impl<char>(fmt.get(), ctx, fargs);
        return n;
    }

    template <typename... Args>
    [[nodiscard]] constexpr klibc::string format(
        format_string<Args...> fmt,
        Args&&... args
    ) {
        klibc::string result;
        format_to(std::back_inserter(result), fmt, std::forward<Args>(args)...);
        return result;
    }

    [[nodiscard]] constexpr inline klibc::string vformat(
        std::string_view fmt,
        format_args args
    ) {
        klibc::string result;
        vformat_to(std::back_inserter(result), fmt, args);
        return result;
    }

    template <typename Context = format_context, typename... Args>
    constexpr auto make_format_args(const Args&... args) noexcept {
        return detail::make_format_args_store<Context>(args...);
    }
}