    template <typename CharT>
    class basic_format_parse_context {
    public:
        using char_type = CharT;
        using const_iterator = typename std::basic_string_view<CharT>::const_iterator;
        using iterator = const_iterator;

        constexpr explicit basic_format_parse_context(std::basic_string_view<CharT> spec) noexcept
            : m_spec(spec) {}

        constexpr basic_format_parse_context(const basic_format_parse_context&) = delete;
        constexpr basic_format_parse_context& operator=(const basic_format_parse_context&) = delete;

        constexpr const_iterator begin() const noexcept { return m_spec.begin(); }
        constexpr const_iterator end() const noexcept { return m_spec.end(); }
        constexpr void advance_to(const_iterator it) noexcept {
            m_spec.remove_prefix(static_cast<std::size_t>(it - m_spec.begin()));
        }

    private:
        std::basic_string_view<CharT> m_spec;
    };

    template <typename OutputIt, typename CharT>
    class basic_format_context {
    public:
        using iterator = OutputIt;
        using char_type = CharT;

        constexpr basic_format_context(
            OutputIt out,
            basic_format_args<basic_format_context> args
        ) noexcept
            : m_out(out), m_args(args)
        {}

        basic_format_context(const basic_format_context&) = delete;
        basic_format_context& operator=(const basic_format_context&) = delete;

        constexpr basic_format_arg<basic_format_context> arg(std::size_t id) const noexcept {
            return m_args.get(id);
        }
        constexpr iterator out() noexcept { return m_out; }
        constexpr void advance_to(iterator it) noexcept { m_out = it; }

    private:
        iterator m_out;
        basic_format_args<basic_format_context> m_args;
    };

    template <typename Context>
    class basic_format_arg {
    public:
        using char_type = typename Context::char_type;

        constexpr basic_format_arg() noexcept = default;

        template <typename T>
        static constexpr basic_format_arg make(const T& value) noexcept {
            basic_format_arg arg;
            arg.m_ptr = static_cast<const void*>(klibc::addressof(value));
            arg.m_format = &format_impl<T>;
            return arg;
        }

        constexpr void format(
            std::basic_string_view<char_type> spec,
            Context& ctx
        ) const {
            assert(m_format && "klibc::format: attempted to format an empty format argument");
            m_format(m_ptr, spec, ctx);
        }

        explicit constexpr operator bool() const noexcept { return m_format != nullptr; }

    private:
        using format_fn = void (*)(const void*, std::basic_string_view<char_type>, Context&);

        template <typename T>
        static constexpr void format_impl(
            const void* ptr,
            std::basic_string_view<char_type> spec,
            Context& ctx
        ) noexcept {
            formatter<T, char_type> f{};
            basic_format_parse_context<char_type> pc(spec);
            pc.advance_to(f.parse(pc));
            ctx.advance_to(f.format(*static_cast<const T*>(ptr), ctx));
        }

        const void* m_ptr = nullptr;
        format_fn m_format = nullptr;
    };

    namespace detail {
        template <typename Context, typename... Args>
        struct format_arg_store {
            static constexpr std::size_t count = sizeof...(Args);
            basic_format_arg<Context> args[count == 0 ? 1 : count];
        };

        template <typename Context, typename... Args>
        constexpr format_arg_store<Context, Args...> make_format_args_store(
            const Args&... args
        ) noexcept {
            return format_arg_store<Context, Args...>{{
                basic_format_arg<Context>::make(args)...
            }};
        }

        template <typename CharT>
        class counting_iterator {
        public:
            using iterator_category = std::output_iterator_tag;
            using value_type = void;
            using difference_type = std::ptrdiff_t;
            using pointer = void;
            using reference = void;

            constexpr explicit counting_iterator(std::size_t* count) noexcept : m_count(count) {}
            constexpr counting_iterator& operator*() noexcept { return *this; }
            constexpr counting_iterator& operator++() noexcept { return *this; }
            constexpr counting_iterator operator++(int) noexcept { return *this; }
            constexpr counting_iterator& operator=(CharT) noexcept { ++(*m_count); return *this; }

        private:
            std::size_t* m_count;
        };

        template <typename OutputIt, typename CharT>
        class truncating_iterator {
        public:
            using iterator_category = std::output_iterator_tag;
            using value_type = void;
            using difference_type = std::ptrdiff_t;
            using pointer = void;
            using reference = void;

            constexpr truncating_iterator(OutputIt out, std::size_t max) noexcept : m_out(out), m_max(max) {}
            constexpr truncating_iterator& operator*() noexcept { return *this; }
            constexpr truncating_iterator& operator++() noexcept { return *this; }
            constexpr truncating_iterator operator++(int) noexcept { return *this; }
            constexpr truncating_iterator& operator=(CharT c) noexcept {
                if (m_written < m_max) { *m_out = c; ++m_out; }
                ++m_written;
                return *this;
            }
            constexpr OutputIt base() const noexcept { return m_out; }
            constexpr std::size_t count() const noexcept { return m_written; }

        private:
            OutputIt m_out;
            std::size_t m_max;
            std::size_t m_written = 0;
        };
    }

    template <typename Context>
    class basic_format_args {
    public:
        constexpr basic_format_args() noexcept = default;

        constexpr basic_format_args(
            const basic_format_arg<Context>* args,
            std::size_t count
        ) noexcept
            : m_args(args), m_count(count)
        {}

        template <typename... Args>
        constexpr basic_format_args(
            const detail::format_arg_store<Context, Args...>& store
        ) noexcept
            : m_args(store.args), m_count(sizeof...(Args))
        {}

        basic_format_arg<Context> get(std::size_t index) const noexcept {
            return index < m_count ? m_args[index] : basic_format_arg<Context>{};
        }
        constexpr std::size_t size() const noexcept { return m_count; }

    private:
        const basic_format_arg<Context>* m_args = nullptr;
        std::size_t m_count = 0;
    };

    template <typename CharT, typename... Args>
    struct basic_format_string {
        template <typename T> requires (
            std::convertible_to<const T&, std::basic_string_view<CharT>>
        )
        consteval basic_format_string(const T& str) noexcept : m_str(str) {
            std::basic_string_view<CharT> sv = m_str;
            for (std::size_t i = 0; i < sv.size(); ++i) {
                CharT c = sv[i];
                if (c == CharT('{')) {
                    if (i + 1 < sv.size() && sv[i + 1] == CharT('{')) { ++i; continue; }
                    std::size_t j = i + 1;
                    while (j < sv.size() && sv[j] != CharT('}')) ++j;
                    if (j >= sv.size()) detail::invalid_format_string();
                    i = j;
                } else if (c == CharT('}')) {
                    if (i + 1 < sv.size() && sv[i + 1] == CharT('}')) { ++i; continue; }
                    detail::invalid_format_string();
                }
            }
        }

        FORCE_INLINE
        constexpr basic_format_string(
            detail::runtime_format_string<CharT> str
        ) noexcept :
            m_str(str.m_str)
        {}

        FORCE_INLINE
        constexpr std::basic_string_view<CharT> get() const noexcept { return m_str; }

    private:
        std::basic_string_view<CharT> m_str;
    };

    constexpr auto runtime_format(std::string_view fmt) noexcept {
        return detail::runtime_format_string<char>(fmt);
    }

    template <class... Args>
    using format_string = basic_format_string<char, std::type_identity_t<Args>...>;

    using format_context = basic_format_context<detail::format_sink<char>, char>;

    template <typename OutputIt, typename CharT>
    using format_args_t = basic_format_args<basic_format_context<OutputIt, CharT>>;

    using format_args = format_args_t<detail::format_sink<char>, char>;

    template <typename CharT>
    struct formatter<CharT, CharT> {
        constexpr auto parse(basic_format_parse_context<CharT>& pc) noexcept {
            m_spec = detail::parse_spec<CharT>(std::basic_string_view<CharT>(pc.begin(), pc.end()));
            assert(
                (m_spec.type == '\0' || m_spec.type == 'c' || m_spec.type == 'b' || m_spec.type == 'B' ||
                 m_spec.type == 'd' || m_spec.type == 'o' || m_spec.type == 'x' || m_spec.type == 'X') &&
                "klibc::format: invalid presentation type for character argument"
            );
            return pc.end();
        }
        template <class FormatContext>
        constexpr auto format(
            CharT value,
            FormatContext& ctx
        ) const noexcept -> typename FormatContext::iterator {
            auto out = ctx.out();
            if (m_spec.type && m_spec.type != 'c') {
                return detail::format_integral_impl<typename FormatContext::iterator, CharT>(
                    out,
                    static_cast<unsigned long long>(static_cast<std::uint8_t>(value)),
                    false,
                    m_spec
                );
            }
            CharT buf[1] = { value };
            return detail::write_aligned<typename FormatContext::iterator, CharT>(
                out,
                buf,
                1,
                m_spec,
                '<'
            );
        }
    private:
        detail::format_spec m_spec{};
    };

    template <typename CharT>
    struct formatter<bool, CharT> {
        constexpr auto parse(basic_format_parse_context<CharT>& pc) noexcept {
            m_spec = detail::parse_spec<CharT>(std::basic_string_view<CharT>(
                pc.begin(),
                pc.end()
            ));
            return pc.end();
        }
        template <class FormatContext>
        constexpr auto format(
            bool value,
            FormatContext& ctx
        ) const noexcept -> typename FormatContext::iterator {
            auto out = ctx.out();
            if (m_spec.type && m_spec.type != 's') {
                return detail::format_integral_impl<typename FormatContext::iterator, CharT>(
                    out, value ? 1ull : 0ull, false, m_spec
                );
            }
            const char* text = value ? "true" : "false";
            std::size_t len = value ? 4 : 5;
            CharT buf[5];
            for (std::size_t i = 0; i < len; ++i) buf[i] = CharT(text[i]);
            return detail::write_aligned<
                typename FormatContext::iterator,
                CharT
            >(out, buf, len, m_spec, '<');
        }
    private:
        detail::format_spec m_spec{};
    };

    // integral (excluding bool and CharT itself)
    template <typename T, typename CharT> requires (
        std::integral<T> && !std::same_as<T, bool> && !std::same_as<T, CharT>
    )
    struct formatter<T, CharT> {
        constexpr auto parse(basic_format_parse_context<CharT>& pc) noexcept {
            m_spec = detail::parse_spec<CharT>(std::basic_string_view<CharT>(
                pc.begin(),
                pc.end()
            ));
            assert(
                (m_spec.type == '\0' || m_spec.type == 'd' || m_spec.type == 'c' ||
                 m_spec.type == 'b' || m_spec.type == 'B' || m_spec.type == 'o' ||
                 m_spec.type == 'x' || m_spec.type == 'X') &&
                "klibc::format: invalid presentation type for integer argument"
            );
            return pc.end();
        }
        template <class FormatContext>
        constexpr auto format(
            T value,
            FormatContext& ctx
        ) const noexcept -> typename FormatContext::iterator {
            auto out = ctx.out();
            if (m_spec.type == 'c') {
                CharT buf[1] = { static_cast<CharT>(value) };
                return detail::write_aligned<typename FormatContext::iterator, CharT>(
                    out,
                    buf,
                    1,
                    m_spec,
                    '<'
                );
            }
            if constexpr (std::is_signed_v<T>) {
                using UT = std::make_unsigned_t<T>;
                bool negative = value < 0;
                UT magnitude = negative
                    ? static_cast<UT>(0) - static_cast<UT>(value)
                    : static_cast<UT>(value);
                return detail::format_integral_impl<typename FormatContext::iterator, CharT>(
                    out, static_cast<unsigned long long>(magnitude), negative, m_spec
                );
            } else {
                return detail::format_integral_impl<typename FormatContext::iterator, CharT>(
                    out, static_cast<unsigned long long>(value), false, m_spec
                );
            }
        }
    private:
        detail::format_spec m_spec{};
    };

    // floating point (fixed-point only)
    template <typename T, typename CharT> requires std::floating_point<T>
    struct formatter<T, CharT> {
        constexpr auto parse(basic_format_parse_context<CharT>& pc) noexcept {
            m_spec = detail::parse_spec<CharT>(std::basic_string_view<CharT>(pc.begin(), pc.end()));
            assert(
                (m_spec.type == '\0' || m_spec.type == 'f' || m_spec.type == 'F') &&
                "klibc::format: only fixed-point ('f'/'F') "
                "floating-point presentation is supported"
            );
            return pc.end();
        }
        template <class FormatContext>
        constexpr auto format(
            T value,
            FormatContext& ctx
        ) const noexcept -> typename FormatContext::iterator {
            return detail::format_float_impl<typename FormatContext::iterator, CharT>(
                ctx.out(),
                value,
                m_spec
            );
        }
    private:
        detail::format_spec m_spec{};
    };

    // C string
    template <typename CharT>
    struct formatter<const CharT*, CharT> {
        constexpr auto parse(basic_format_parse_context<CharT>& pc) noexcept {
            m_spec = detail::parse_spec<CharT>(std::basic_string_view<CharT>(pc.begin(), pc.end()));
            assert((m_spec.type == '\0' || m_spec.type == 's') &&
                "klibc::format: invalid presentation type for string argument");
            return pc.end();
        }
        template <class FormatContext>
        constexpr auto format(
            const CharT* value,
            FormatContext& ctx
        ) const noexcept -> typename FormatContext::iterator {
            assert(value && "klibc::format: null C-string argument");
            std::basic_string_view<CharT> sv(value);
            if (m_spec.precision != detail::no_precision && m_spec.precision < sv.size())
                sv = sv.substr(0, m_spec.precision);
            return detail::write_aligned<typename FormatContext::iterator, CharT>(
                ctx.out(),
                sv.data(),
                sv.size(),
                m_spec,
                '<'
            );
        }
    private:
        detail::format_spec m_spec{};
    };

