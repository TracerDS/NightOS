        void invalid_format_string() noexcept;

        // ---------------- format spec ----------------
        constexpr std::size_t no_precision = static_cast<std::size_t>(-1);

        struct format_spec {
            char fill = ' ';       // ASCII only (see header notes)
            char align = '\0';     // '<' '>' '^' or 0 = unset
            char sign = '-';       // '-' '+' ' '
            bool alt = false;      // '#'
            bool zero = false;     // leading '0'
            std::size_t width = 0;
            std::size_t precision = no_precision;
            char type = '\0';      // presentation type, 0 = unset
        };

        template <typename CharT>
        constexpr format_spec parse_spec(std::basic_string_view<CharT> s) noexcept {
            format_spec spec;
            std::size_t i = 0;

            if (i + 1 < s.size() &&
                (s[i + 1] == CharT('<') || s[i + 1] == CharT('>') || s[i + 1] == CharT('^'))
            ) {
                spec.fill = static_cast<char>(s[i]);
                spec.align = static_cast<char>(s[i + 1]);
                i += 2;
            } else if (i < s.size() &&
                (s[i] == CharT('<') || s[i] == CharT('>') || s[i] == CharT('^'))
            ) {
                spec.align = static_cast<char>(s[i]);
                ++i;
            }

            if (i < s.size() && (s[i] == CharT('+') || s[i] == CharT('-') || s[i] == CharT(' '))) {
                spec.sign = static_cast<char>(s[i]);
                ++i;
            }
            if (i < s.size() && s[i] == CharT('#')) { spec.alt = true; ++i; }
            if (i < s.size() && s[i] == CharT('0')) { spec.zero = true; ++i; }

            if (i < s.size() && s[i] >= CharT('0') && s[i] <= CharT('9')) {
                std::size_t w = 0;
                while (i < s.size() && s[i] >= CharT('0') && s[i] <= CharT('9')) {
                    w = w * 10 + static_cast<std::size_t>(s[i] - CharT('0'));
                    ++i;
                }
                spec.width = w;
            }

            if (i < s.size() && s[i] == CharT('.')) {
                ++i;
                std::size_t p = 0;
                while (i < s.size() && s[i] >= CharT('0') && s[i] <= CharT('9')) {
                    p = p * 10 + static_cast<std::size_t>(s[i] - CharT('0'));
                    ++i;
                }
                spec.precision = p;
            }

            if (i < s.size()) {
                spec.type = static_cast<char>(s[i]);
                ++i;
            }

            return spec;
        }

        template <typename CharT, std::integral T>
        constexpr std::size_t to_chars_uint(CharT* buf, T value, int base, bool uppercase) noexcept {
            CharT tmp[70];
            std::size_t n = 0;
            T b = static_cast<T>(base);
            if (value == 0) {
                tmp[n++] = CharT('0');
            }
            while (value != 0) {
                auto digit = static_cast<unsigned>(value % b);
                tmp[n++] = digit < 10
                    ? CharT('0' + digit)
                    : CharT((uppercase ? 'A' : 'a') + digit - 10);
                value /= b;
            }
            for (std::size_t i = 0; i < n; ++i) {
                buf[i] = tmp[n - 1 - i];
            }
            return n;
        }

        // Pads/aligns an already-rendered body according to spec.width/fill/align.
        template <typename OutputIt, typename CharT>
        constexpr OutputIt write_aligned(
            OutputIt out,
            const CharT* body,
            std::size_t len,
            const format_spec& spec,
            char defaultAlign
        ) noexcept {
            if (len >= spec.width) {
                for (std::size_t i = 0; i < len; ++i) *out++ = body[i];
                return out;
            }
            std::size_t pad = spec.width - len;
            char align = spec.align ? spec.align : defaultAlign;
            CharT fillCh = static_cast<CharT>(spec.fill);

            std::size_t left = 0, right = 0;
            if (align == '<') right = pad;
            else if (align == '^') { left = pad / 2; right = pad - left; }
            else left = pad; // '>' / default

            for (std::size_t i = 0; i < left; ++i)  *out++ = fillCh;
            for (std::size_t i = 0; i < len; ++i)   *out++ = body[i];
            for (std::size_t i = 0; i < right; ++i) *out++ = fillCh;
            return out;
        }

        // Writes [sign][prefix][digits], honoring zero-fill (inserted after
        // sign/prefix, before digits) or generic alignment otherwise.
        template <typename OutputIt, typename CharT>
        constexpr OutputIt write_number(
            OutputIt out,
            const CharT* sign, std::size_t signLen,
            const CharT* prefix, std::size_t prefixLen,
            const CharT* digits, std::size_t digitsLen,
            const format_spec& spec
        ) noexcept {
            std::size_t contentLen = signLen + prefixLen + digitsLen;
            if (spec.zero && !spec.align && contentLen < spec.width) {
                std::size_t zeros = spec.width - contentLen;
                for (std::size_t i = 0; i < signLen; ++i)   *out++ = sign[i];
                for (std::size_t i = 0; i < prefixLen; ++i) *out++ = prefix[i];
                for (std::size_t i = 0; i < zeros; ++i)     *out++ = CharT('0');
                for (std::size_t i = 0; i < digitsLen; ++i) *out++ = digits[i];
                return out;
            }
            CharT buf[96];
            std::size_t n = 0;
            for (std::size_t i = 0; i < signLen; ++i)   buf[n++] = sign[i];
            for (std::size_t i = 0; i < prefixLen; ++i) buf[n++] = prefix[i];
            for (std::size_t i = 0; i < digitsLen; ++i) buf[n++] = digits[i];
            return write_aligned<OutputIt, CharT>(out, buf, n, spec, '>');
        }

        template <typename OutputIt, typename CharT>
        constexpr OutputIt format_integral_impl(
            OutputIt out,
            unsigned long long magnitude,
            bool negative,
            const format_spec& spec
        ) noexcept {
            char type = spec.type ? spec.type : 'd';
            int base = 10;
            bool upper = false;
            CharT prefixBuf[2]{};
            std::size_t prefixLen = 0;

            switch (type) {
                case 'b':
                    base = 2;
                    if (spec.alt) {
                        prefixBuf[0] = CharT('0');
                        prefixBuf[1] = CharT('b');
                        prefixLen = 2;
                    }
                    break;
                case 'B':
                    base = 2;
                    if (spec.alt) {
                        prefixBuf[0] = CharT('0');
                        prefixBuf[1] = CharT('B');
                        prefixLen=2;
                    }
                    break;
                case 'o':
                    base = 8;
                    if (spec.alt && magnitude != 0) {
                        prefixBuf[0] = CharT('0');
                        prefixLen=1;
                    }
                    break;
                case 'x':
                    base = 16;
                    if (spec.alt) {
                        prefixBuf[0] = CharT('0');
                        prefixBuf[1] = CharT('x');
                        prefixLen = 2;
                    }
                    break;
                case 'X':
                    base = 16;
                    upper = true;
                    if (spec.alt) {
                        prefixBuf[0] = CharT('0');
                        prefixBuf[1] = CharT('X');
                        prefixLen = 2;
                    }
                    break;
                default:
                    base = 10;
                    break;
            }

            CharT signBuf[1]{};
            std::size_t signLen = 0;
            if (negative)                 { signBuf[0] = CharT('-'); signLen = 1; }
            else if (spec.sign == '+')    { signBuf[0] = CharT('+'); signLen = 1; }
            else if (spec.sign == ' ')    { signBuf[0] = CharT(' '); signLen = 1; }

            CharT digits[70];
            std::size_t n = to_chars_uint<CharT>(digits, magnitude, base, upper);

            return write_number<OutputIt, CharT>(
                out,
                signBuf,
                signLen,
                prefixBuf,
                prefixLen,
                digits,
                n,
                spec
            );
        }

        // Fixed-point only (matches Terminal::write_float's capability).
        template <typename OutputIt, typename CharT, std::floating_point T>
        constexpr OutputIt format_float_impl(
            OutputIt out,
            T value,
            const format_spec& spec
        ) noexcept {
            bool negative = value < T(0);
            double mag = negative ? -static_cast<double>(value) : static_cast<double>(value);

            if (mag != mag || mag > (std::numeric_limits<double>::max)()) {
                const char* s = (mag != mag) ? "nan" : "inf";
                CharT buf[4];
                std::size_t n = 0;
                if (negative)
                    buf[n++] = CharT('-');
                for (int i = 0; i < 3; ++i) buf[n++] = CharT(s[i]);
                return write_aligned<OutputIt, CharT>(out, buf, n, spec, '>');
            }

            std::size_t precision = spec.precision != no_precision ? spec.precision : 6;

            auto intPart = static_cast<std::uint64_t>(mag);
            double frac = mag - static_cast<double>(intPart);

            CharT intDigits[24];
            std::size_t intLen = to_chars_uint<CharT>(intDigits, intPart, 10, false);

            CharT fracDigits[32];
            std::size_t fracLen = 0;
            if (precision > 0) {
                double rounding = 0.5;
                for (std::size_t i = 0; i < precision; ++i) rounding /= 10.0;
                frac += rounding;
                for (std::size_t i = 0; i < precision && fracLen < 32; ++i) {
                    frac *= 10.0;
                    auto digit = static_cast<unsigned>(frac);
                    if (digit > 9) digit = 9;
                    fracDigits[fracLen++] = CharT('0' + digit);
                    frac -= digit;
                }
            }

            CharT signBuf[1]{};
            std::size_t signLen = 0;
            if (negative)              { signBuf[0] = CharT('-'); signLen = 1; }
            else if (spec.sign == '+') { signBuf[0] = CharT('+'); signLen = 1; }
            else if (spec.sign == ' ') { signBuf[0] = CharT(' '); signLen = 1; }

            CharT body[96];
            std::size_t n = 0;
            for (std::size_t i = 0; i < signLen; ++i) body[n++] = signBuf[i];
            for (std::size_t i = 0; i < intLen; ++i)  body[n++] = intDigits[i];

            if (precision > 0 || spec.alt) {
                body[n++] = CharT('.');
                for (std::size_t i = 0; i < fracLen; ++i) body[n++] = fracDigits[i];
            }

            if (spec.zero && !spec.align && n < spec.width) {
                CharT padded[128];
                std::size_t m = 0;
                std::size_t zeros = spec.width - n;
                for (std::size_t i = 0; i < signLen; ++i)    padded[m++] = signBuf[i];
                for (std::size_t i = 0; i < zeros; ++i)      padded[m++] = CharT('0');
                for (std::size_t i = signLen; i < n; ++i)    padded[m++] = body[i];
                for (std::size_t i = 0; i < m; ++i) *out++ = padded[i];
                return out;
            }

            return write_aligned<OutputIt, CharT>(out, body, n, spec, '>');
        }

        template <typename OutputIt, typename CharT>
        constexpr OutputIt format_pointer_impl(
            OutputIt out,
            const void* value,
            format_spec spec
        ) noexcept {
            spec.type = 'x';
            spec.alt = true;
            return format_integral_impl<OutputIt, CharT>(
                out,
                static_cast<unsigned long long>(reinterpret_cast<std::uintptr_t>(value)),
                false,
                spec
            );
        }

        template <typename CharT>
        using format_sink = std::back_insert_iterator<klibc::basic_string<CharT>>;
    }

