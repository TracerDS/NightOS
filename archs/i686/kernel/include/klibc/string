        constexpr basic_string& erase(
            size_type index = 0,
            size_type count = npos
        ) noexcept {
            assert(index <= size() && "basic_string::erase: index out of range");
            size_type n = std::min(count, size() - index);
            if (n == 0)
                return *this;

            size_type oldN = size();
            size_type newN = oldN - n;

            if (_m_is_heap()) {
                traits_type::move(m_heap.data + index, m_heap.data + index + n, oldN - index - n);
                m_heap.size = newN;
                m_heap.data[newN] = value_type{};
            } else {
                traits_type::move(m_stack.data + index, m_stack.data + index + n, oldN - index - n);
                Tag::set_stack_size(m_stack, newN);
                m_stack.data[newN] = value_type{};
            }
            return *this;
        }

