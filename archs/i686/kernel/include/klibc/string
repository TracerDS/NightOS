namespace klibc {
    
    namespace detail {
        template <typename T>
        struct char_types {
            using int_type = unsigned long;
        };

        template<class R, class T>
        concept container_compatible_range =
            std::ranges::input_range<R> &&
            std::convertible_to<std::ranges::range_reference_t<R>, T>;

        template <class Traits, class = void>
        struct comparison_category {
            using type = std::weak_ordering;
        };

        template <class Traits>
        struct comparison_category<Traits, std::void_t<typename Traits::comparison_category>> {
            using type = typename Traits::comparison_category;
        };

        template <class Traits>
        using comparison_category_t = typename comparison_category<Traits>::type;
    }

    template <class CharT>
    struct char_traits {
        using char_type = CharT;
        using int_type = typename detail::char_types<char_type>::int_type;
#if __cpp_lib_three_way_comparison
        using comparison_category = std::strong_ordering;
#endif

        static constexpr void assign(char_type& dest, const char_type& src) noexcept {
            if (std::is_constant_evaluated()) {
                std::construct_at(std::addressof(dest), src);
            } else {
                dest = src;
            }
        }
        
        static constexpr char_type* assign(
            char_type* dest,
            std::size_t count,
            char_type what
        ) noexcept {
            if (std::is_constant_evaluated()) {
                for (std::size_t i = 0; i < count; ++i) {
                    std::construct_at(std::addressof(dest[i]), what);
                }
                return dest;
            }

            if constexpr (
                sizeof(char_type) == 1 &&
                std::is_trivially_default_constructible_v<char_type> &&
                std::is_trivially_copyable_v<char_type>
            ) {
                if (count > 0) {
                    std::uint8_t c;
                    klibc::memcpy(&c, std::addressof(what), 1);
                    klibc::memset(dest, c, count);
                }
            } else {
                klibc::memset(dest, what, count);
            }
            return dest;
        }

        static constexpr bool eq(const char_type& c1, const char_type& c2) noexcept {
            return c1 == c2;
        }
        static constexpr bool lt(const char_type& c1, const char_type& c2) noexcept {
            return c1 < c2;
        }
        static constexpr char_type* move(
            char_type* dest,
            const char_type* src,
            std::size_t count
        ) {
            if (count == 0)
                return dest;
            
            if (std::is_constant_evaluated()) {
                // Check if its a constant expression
                // and if the pointers are related
                if (
#ifdef __NOS_KERNEL_COMPILER_GCC__
                    __builtin_constant_p(src < dest) &&
#endif
                    dest > src &&
                    dest < (src + count)
                ) {
                    // overlapped, copy backwards
                    while (count > 0) {
                        count--;
                        assign(dest[count], src[count]);
                    }
                } else {
                    // not overlapping, copy forwards
                    copy(dest, src, count);
                }
                return dest;
            }
            klibc::memmove(dest, src, count * sizeof(char_type));

            return dest;
        }
        
        static constexpr char_type* copy(
            char_type* dest,
            const char_type* src,
            std::size_t count
        ) {
            if (count == 0)
                return dest;
            
            if (std::is_constant_evaluated()) {
                for (std::size_t i = 0; i < count; ++i) {
                    std::construct_at(std::addressof(dest[i]), src[i]);
                }
            } else {
                klibc::memcpy(dest, src, count * sizeof(char_type));
            }
            return dest;
        }

        static constexpr char_type* compare(
            const char_type* dest,
            const char_type* src,
            std::size_t count
        ) noexcept {
            for (std::size_t i = 0; i < count; ++i) {
                if (lt(dest[i], src[i]))
                    return -1;
                else if (lt(src[i], dest[i]))
                    return 1;
            }
            return 0;
        }

        static constexpr std::size_t length(
            const char_type* str
        ) noexcept {
            std::size_t i = 0;
            while (!eq(str[i], char_type{}))
                ++i;
            return i;
        }

        static constexpr char_type find(
            const char_type* src,
            std::size_t count,
            const char_type& what
        ) {
            for (std::size_t i = 0; i < count; ++i)
                if (eq(src[i], what))
                    return src + i;

            return 0;
        }

        static constexpr char_type to_char_type(
            const int_type& value
        ) noexcept {
            return static_cast<char_type>(value);
        }

        static constexpr int_type to_int_type(
            const char_type& value
        ) noexcept {
            return static_cast<int_type>(value);
        }

        static constexpr bool eq_int_type(
            const int_type& a,
            const int_type& b
        ) noexcept {
            return a == b;
        }

        static constexpr int_type eof() noexcept {
            return static_cast<int_type>(-1);
        }

        static constexpr int_type not_eof(const int_type& value) noexcept {
            if (!eq_int_type(value, eof()))
                return value;
            else
                return to_int_type(char_type{});
        }
    };

    template <
        class CharT,
        class Traits = char_traits<CharT>,
        class Allocator = allocator<CharT>
    >
    class basic_string {
    public:
        using traits_type            = Traits;
        using value_type             = typename traits_type::char_type;
        using allocator_type         = Allocator;
        using size_type              = typename allocator_traits<allocator_type>::size_type;
        using difference_type        = typename allocator_traits<allocator_type>::difference_type;
        using reference              = value_type&;
        using const_reference        = const value_type&;
        using pointer                = typename allocator_traits<allocator_type>::pointer;
        using const_pointer          = typename allocator_traits<allocator_type>::const_pointer;
        using iterator               = pointer;
        using const_iterator         = const_pointer;
        using const_reverse_iterator = std::reverse_iterator<const_iterator>;
        using reverse_iterator       = std::reverse_iterator<iterator>;

        static constexpr size_type npos = static_cast<size_type>(-1);
    protected:

    public:
#pragma region Public functions
        constexpr basic_string() noexcept(noexcept(allocator_type()))
            : basic_string(allocator_type())
        {}

        constexpr explicit basic_string(const allocator_type& alloc) noexcept
            : m_allocator(alloc)
        {
            Tag::set_stack_size(m_stack, 0);
            m_stack.data[0] = value_type{};
        }

        constexpr basic_string(
            size_type count,
            value_type chr,
            const allocator_type& alloc = allocator_type()
        ) noexcept : m_allocator(alloc)
        {
            if (count <= StackMeta::capacity) {
                traits_type::assign(m_stack.data, count, chr);
                Tag::set_stack_size(m_stack, count);
                m_stack.data[count] = value_type{};
            } else {
                pointer p = m_allocator.allocate(count + 1);
                traits_type::assign(p, count, chr);
                p[count] = value_type{};
                m_heap.data = p;
                m_heap.size = count;
                Tag::set_heap_capacity(m_heap, count);
            }
        }

        template <class InputIt>
        constexpr basic_string(
            InputIt first,
            InputIt last,
            const allocator_type& alloc = allocator_type()
        ) noexcept : m_allocator(alloc)
        {
            _m_assign_range(first, last, std::iterator_traits<InputIt>::iterator_category());
        }

        template <detail::container_compatible_range<value_type> R>
        constexpr basic_string(
            from_range_t,
            R&& range,
            const Allocator& allocator = Allocator()
        ) noexcept
            : m_allocator(allocator)
        {
            Tag::set_stack_size(m_stack, 0);
            m_stack.data[0] = value_type{};
            assign_from_range(std::forward<R>(range));
        }
        
        constexpr basic_string(
            const value_type* string,
            size_type count,
            const allocator_type& alloc = allocator_type()
        ) noexcept
            : m_allocator(alloc)
        {
            _m_assign_from(string, count);
        }

        constexpr basic_string(
            const value_type* string,
            const allocator_type& alloc = allocator_type()
        ) noexcept
            : basic_string(string, traits_type::length(string), alloc)
        {}

        constexpr basic_string(std::nullptr_t) = delete;

        constexpr basic_string(const basic_string& other) noexcept
            : basic_string(other, other.m_allocator)
        {}

        constexpr basic_string(basic_string&& other) noexcept
            : m_allocator(std::move(other.m_allocator))
        {
            if (Tag::_m_is_heap(other.m_stack)) {
                m_heap = other.m_heap;
                Tag::set_stack_size(other.m_stack, 0);
                other.m_stack.data[0] = value_type{};
            } else {
                m_stack = other.m_stack;
            }
        }

        constexpr basic_string(
            const basic_string& other,
            const allocator_type& alloc
        ) noexcept
            : m_allocator(alloc)
        {
            _m_assign_from(other.data(), other.size());
        }

        constexpr basic_string(
            basic_string&& other,
            const allocator_type& alloc
        ) noexcept
            : m_allocator(alloc)
        {
            if (other._m_is_heap()) {
                if (m_allocator == other.m_allocator) {
                    // Same allocator: steal the buffer, O(1).
                    m_heap = other.m_heap;
                    Tag::set_stack_size(other.m_stack, 0);
                    other.m_stack.data[0] = value_type{};
                    return;
                }
                // Different allocators: buffer was obtained from a foreign
                // allocator, cannot be freed by ours - must copy instead.
                _m_assign_from(other.data(), other.size());
                other._m_release();
                Tag::set_stack_size(other.m_stack, 0);
                other.m_stack.data[0] = value_type{};
            } else {
                m_stack = other.m_stack;
            }
        }

        constexpr basic_string(
            const basic_string& other,
            size_type pos,
            const allocator_type& alloc = allocator_type()
        ) noexcept
            : basic_string(other, pos, npos, alloc) {}

        constexpr basic_string(
            basic_string&& other,
            size_type pos,
            const allocator_type& alloc = allocator_type()
        ) noexcept
            : basic_string(std::move(other), pos, npos, alloc)
        {}

        constexpr basic_string(
            const basic_string& other,
            size_type pos,
            size_type count,
            const allocator_type& alloc = allocator_type()
        ) noexcept
            : m_allocator(alloc)
        {
            assert(pos <= other.size() && "basic_string: pos out of range");
            size_type n = std::min(count, other.size() - pos);
            _m_assign_from(other.data() + pos, n);
        }

        constexpr basic_string(
            basic_string&& other,
            size_type pos,
            size_type count,
            const allocator_type& alloc = allocator_type()
        ) noexcept
            : m_allocator(alloc)
        {
            assert(pos <= other.size() && "basic_string: pos out of range");
            size_type n = std::min(count, other.size() - pos);

            // Whole-string "substring" starting at 0: eligible for the same
            // ownership-transfer fast path as the plain move ctor.
            if (
                pos == 0 && n == other.size() && other._m_is_heap() &&
                m_allocator == other.m_allocator
            ) {
                m_heap = other.m_heap;
                Tag::set_stack_size(other.m_stack, 0);
                other.m_stack.data[0] = value_type{};
                return;
            }

            // Otherwise it's a genuine slice: must copy the requested range
            // regardless of source mode, since the source's allocation (if
            // any) covers more than just [pos, pos+n).
            _m_assign_from(other.data() + pos, n);
            other._m_release();
            Tag::set_stack_size(other.m_stack, 0);
            other.m_stack.data[0] = value_type{};
        }

        constexpr basic_string(
            std::initializer_list<value_type> list,
            const allocator_type& allocator = allocator_type()
        ) noexcept
            : basic_string(list.begin(), list.end(), allocator)
        {}

        constexpr ~basic_string() noexcept { _m_release(); }

        constexpr basic_string& operator=(const basic_string& other) noexcept {
            if (this == other)
                return *this;

            _m_release();
            if (other._m_is_heap()) {
                m_heap = other.m_heap;
                Tag::set_stack_size(other.m_stack, 0);
                other.m_stack.data[0] = value_type{};
            } else {
                m_stack = other.m_stack;
            }
            return *this;
        }
        
        constexpr basic_string& operator=(basic_string&& other) noexcept {
            if (this == &other)
                return *this;
            
            if (_m_is_heap())
                m_allocator.deallocate(m_heap.m_data, Tag::get_heap_capacity(m_heap) + 1);

            if (other._m_is_heap()) {
                m_heap = other.m_heap;
                Tag::set_stack_size(other.m_stack, 0);
            } else {
                m_stack = other.m_stack;
            }
            return *this;
        }

        constexpr basic_string& operator=(const value_type* string) noexcept {
            size_type n = traits_type::length(string);

            // Guard the case where string aliases our own buffer's storage;
            // _m_release() must not run before we've read from string.
            if (!_m_is_heap() && n <= StackMeta::capacity) {
                // Safe to overwrite in place: source is either foreign memory
                // or the same short buffer being reassigned to itself/a slice
                // of itself
                value_type tmp[StackMeta::capacity + 1];
                traits_type::copy(tmp, string, n);
                tmp[n] = value_type{};
                _m_release();
                traits_type::copy(m_stack.data, tmp, n);
                Tag::set_stack_size(m_stack, n);
                m_stack.data[n] = value_type{};
                return *this;
            }

            _m_release();
            _m_assign_from(string, n);
            return *this;
        }

        constexpr basic_string& operator=(value_type chr) noexcept {
            _m_release();
            m_stack.data[0] = chr;
            Tag::set_stack_size(m_stack, 1);
            m_stack.data[1] = value_type{};
            return *this;
        }

        constexpr basic_string& operator=(std::initializer_list<value_type> list) noexcept {
            _m_release();
            _m_assign_from(list.begin(), static_cast<size_type>(list.size()));
            return *this;
        }

        template <class StringViewLike> requires (
            std::is_convertible_v<
                const StringViewLike&,
                std::basic_string_view<value_type, traits_type>
            > &&
            !std::is_convertible_v<const StringViewLike&, const_pointer>
        )
        constexpr basic_string& operator=(const StringViewLike& string) noexcept {
            std::basic_string_view<value_type, traits_type> view = string;
            _m_release();
            _m_assign_from(view.data(), view.size());
            return *this;
        }

        constexpr basic_string& operator=(std::nullptr_t) = delete;

        constexpr basic_string& assign(const basic_string& str) noexcept {
            return *this = str;
        }

        constexpr basic_string& assign(basic_string&& string) noexcept {
            return *this = std::move(string);
        }

        constexpr basic_string& assign(size_type count, value_type chr) noexcept {
            clear();
            resize(chr, count);
            return *this;
        }

        constexpr basic_string& assign(const value_type* string, size_type count) noexcept {
            if (count <= StackMeta::capacity) {
                value_type tmp[StackMeta::capacity + 1];
                traits_type::copy(tmp, string, count);
                tmp[count] = value_type{};
                _m_release();
                traits_type::copy(m_stack.data, tmp, count);
                Tag::set_stack_size(m_stack, count);
                m_stack.data[count] = value_type{};
                return *this;
            }

            pointer p = m_allocator.allocate(count + 1);
            traits_type::copy(p, string, count);
            p[count] = value_type{};
            _m_release();
            m_heap.data = p;
            m_heap.size = count;
            Tag::set_heap_capacity(m_heap, count);
            return *this;
        }

        constexpr basic_string& assign(const value_type* s) noexcept {
            return assign(s, traits_type::length(s));
        }

        template <class StringView>
        constexpr basic_string& assign(const StringView& string) noexcept {
            std::basic_string_view<value_type, traits_type> view = string;
            return assign(view.data(), view.size());
        }
        
        template <class StringView>
        constexpr basic_string& assign(
            const StringView& string,
            size_type pos,
            size_type count = npos
        ) noexcept {
            std::basic_string_view<value_type, traits_type> view = string;
            return assign(view.substr(pos, count));
        }

        constexpr basic_string& assign(
            const basic_string& string,
            size_type pos,
            size_type count = npos
        ) noexcept {
            return assign(
                std::basic_string_view<value_type, traits_type>(string).substr(pos, count)
            );
        }

        template <typename InputIt>
        constexpr basic_string& assign(InputIt first, InputIt last) noexcept {
            return assign(basic_string(first, last, get_allocator()));
        }

        constexpr basic_string& assign(std::initializer_list<value_type> list) noexcept {
            return assign(list.begin(), list.size());
        }

        template <detail::container_compatible_range<value_type> R>
        constexpr basic_string& assign_range(R&& range) noexcept {
            return assign(basic_string(
                from_range,
                std::forward<R>(range),
                get_allocator()
            ));
        }

        constexpr allocator_type get_allocator() const noexcept { return m_allocator; }

        constexpr reference at(size_type pos) noexcept {
            assert(pos < size() && "basic_string: pos out of range");
            return data()[pos];
        }
        constexpr const_reference at(size_type pos) const noexcept {
            assert(pos < size() && "basic_string: pos out of range");
            return data()[pos];
        }

        constexpr reference operator[](size_type pos) noexcept {
            return data()[pos];
        }
        constexpr const_reference operator[](size_type pos) const noexcept {
            return data()[pos];
        }

        constexpr reference front() noexcept {
            assert(!empty() && "basic_string: front() called on empty string");
            return operator[](0);
        }
        constexpr const_reference front() const noexcept {
            assert(!empty() && "basic_string: front() called on empty string");
            return operator[](0);
        }

        constexpr reference back() noexcept {
            assert(!empty() && "basic_string: back() called on empty string");
            return operator[](size() - 1);
        }
        constexpr const_reference back() const noexcept {
            assert(!empty() && "basic_string: back() called on empty string");
            return operator[](size() - 1);
        }
        
        constexpr pointer data() noexcept {
            return _m_is_heap() ? m_heap.data : m_stack.data;
        }
        constexpr const_pointer data() const noexcept {
            return _m_is_heap() ? m_heap.data : m_stack.data;
        }
        constexpr const_pointer c_str() const noexcept { return data(); }

        constexpr operator std::basic_string_view<value_type, traits_type>() const noexcept {
            return std::basic_string_view<value_type, traits_type>(data(), size());
        }
        
        constexpr iterator begin() noexcept { return data(); }
        constexpr const_iterator begin() const noexcept { return cbegin(); }
        constexpr const_iterator cbegin() const noexcept { return data(); }
        
        constexpr iterator end() noexcept { return data() + size(); }        
        constexpr const_iterator end() const noexcept { return cend(); }        
        constexpr const_iterator cend() const noexcept { return data() + size(); }

        constexpr reverse_iterator rbegin() noexcept {
            return reverse_iterator(end());
        }
        constexpr const_reverse_iterator rbegin() const noexcept {
            return crbegin();
        }
        constexpr const_reverse_iterator crbegin() const noexcept {
            return const_reverse_iterator(cend());
        }
        
        constexpr reverse_iterator rend() noexcept {
            return reverse_iterator(end());
        }
        constexpr const_reverse_iterator rend() const noexcept {
            return crend();
        }
        constexpr const_reverse_iterator crend() const noexcept {
            return const_reverse_iterator(cend());
        }

        constexpr bool empty() const noexcept { return cbegin() == cend(); }

        constexpr size_type size() const noexcept {
            return _m_is_heap() ? m_heap.size : Tag::get_stack_size(m_stack);
        }
        constexpr size_type length() const noexcept { return size(); }

        constexpr size_type max_size() const noexcept {
            // -1 for null terminator
            return (std::numeric_limits<size_type>::max() >> 1) - 1;
        }

        constexpr void reserve(size_type newCapacity) noexcept {
            assert(
                newCapacity <= max_size() &&
                "basic_string::reserve: requested capacity exceeds max_size()"
            );

            if (newCapacity <= capacity())
                return; // already sufficient; reserve() never shrinks

            size_type n = size();
            pointer p = m_allocator.allocate(newCapacity + 1);
            traits_type::copy(p, data(), n);
            p[n] = value_type{};

            _m_release(); // safe: data() was already fully copied into p above
            m_heap.data = p;
            m_heap.size = n;
            Tag::set_heap_capacity(m_heap, newCapacity);
        }

        constexpr size_type capacity() const noexcept {
            return _m_is_heap() ? Tag::get_heap_capacity(m_heap) : StackMeta::capacity;
        }

        constexpr void shrink_to_fit() noexcept {
            if (!_m_is_heap())
                return; // fixed-size union: nothing to shrink in short mode

            size_type n = m_heap.size;

            if (n <= StackMeta::capacity) {
                // Demote to short mode.
                pointer old = m_heap.data;
                size_type oldCap = Tag::get_heap_capacity(m_heap);
                value_type tmp[StackMeta::capacity + 1];
                traits_type::copy(tmp, old, n);
                tmp[n] = value_type{};

                m_allocator.deallocate(old, oldCap + 1);
                traits_type::copy(m_stack.data, tmp, n);
                Tag::set_stack_size(m_stack, n);
                m_stack.data[n] = value_type{};
                return;
            }

            if (Tag::get_heap_capacity(m_heap) == n)
                return; // already tight

            pointer p = m_allocator.allocate(n + 1);
            traits_type::copy(p, m_heap.data, n);
            p[n] = value_type{};
            m_allocator.deallocate(m_heap.data, Tag::get_heap_capacity(m_heap) + 1);
            m_heap.data = p;
            m_heap.size = n;
            Tag::set_heap_capacity(m_heap, n);
        }

        constexpr void clear() noexcept {
            if (_m_is_heap()) {
                m_heap.size = 0;
                m_heap.data[0] = value_type{};
            } else {
                Tag::set_stack_size(m_stack, 0);
                m_stack.data[0] = value_type{};
            }
        }

        constexpr basic_string& insert(
            size_type index,
            size_type count,
            value_type chr
        ) noexcept {
            if (count == 0)
                return *this;
            pointer base = _m_make_gap(index, count);
            traits_type::assign(base + index, count, chr);
            return *this;
        }

        constexpr basic_string& insert(
            size_type index,
            const value_type* string
        ) noexcept {
            return insert(index, string, traits_type::length(string));
        }

        constexpr basic_string& insert(
            size_type index,
            const value_type* string,
            size_type count
        ) noexcept {
            return _m_insert_impl(index, string, count);
        }

        constexpr basic_string& insert(
            size_type index,
            const basic_string& str
        ) noexcept {
            return insert(index, str.data(), str.size());
        }

        constexpr basic_string& insert(
            size_type index,
            const basic_string& string,
            size_type stringIndex,
            size_type count = npos
        ) noexcept {
            assert(stringIndex <= string.size() && "basic_string::insert: stringIndex out of range");
            size_type n = std::min(count, string.size() - stringIndex);
            return insert(index, string.data() + stringIndex, n);
        }

        constexpr iterator insert(
            const_iterator pos,
            value_type chr
        ) noexcept {
            size_type index = pos - cbegin();
            pointer base = _m_make_gap(index, 1);
            base[index] = chr;
            return base + index;
        }

        constexpr iterator insert(
            const_iterator pos,
            size_type count,
            value_type chr
        ) noexcept {
            size_type index = pos - cbegin();
            if (count == 0)
                return data() + index;
