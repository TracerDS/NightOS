    private:
#pragma region Internal functions
        static constexpr pointer _m_allocate(allocator_type& alloc, size_type count) {
            pointer p = allocator_traits<allocator_type>::allocate(alloc, count);
            if constexpr (!std::is_same_v<traits_type, char_traits<value_type>>) {
                if (std::is_constant_evaluated()) {
                    for (size_type i = 0; i < count; ++i) {
                        std::construct_at(std::addressof(p[i]));
                    }
                }
            }
            return p;
        }

        constexpr void _m_release() noexcept {
            if (_m_is_heap()) {
                m_allocator.deallocate(m_heap.data, Tag::get_heap_capacity(m_heap) + 1);
            }
        }

        constexpr void _m_assign_from(const value_type* string, size_type count) {
            if (count <= StackMeta::capacity) {
                traits_type::copy(m_stack.data, string, count);
                Tag::set_stack_size(m_stack, count);
                m_stack.data[count] = value_type{};
            } else {
                pointer p = m_allocator.allocate(count + 1);
                traits_type::copy(p, string, count);
                p[count] = value_type{};
                m_heap.data = p;
                m_heap.size = count;
                Tag::set_heap_capacity(m_heap, count);
            }
        }

        template <typename ForwardIt>
        constexpr void _m_assign_range(
            ForwardIt first,
            ForwardIt last,
            std::forward_iterator_tag
        ) noexcept {
            size_type count = std::distance(first, last);
            if (count <= StackMeta::capacity) {
                size_type i = 0;
                for (; first != last; ++first, ++i)
                    m_stack.data[i] = *first;
                Tag::set_stack_size(m_stack, count);
                m_stack.data[count] = value_type{};
            } else {
                pointer p = m_allocator.allocate(count + 1);
                size_type i = 0;
                for (; first != last; ++first, ++i)
                    p[i] = *first;
                p[count] = value_type{};
                m_heap.data = p;
                m_heap.size = count;
                Tag::set_heap_capacity(m_heap, count);
            }
        }

        template <typename InputIt>
        constexpr void _m_assign_range(
            InputIt first,
            InputIt last,
            std::input_iterator_tag
        ) noexcept {
            Tag::set_stack_size(m_stack, 0);
            m_stack.data[0] = value_type{};
            for (; first != last; ++first)
                push_back(*first);
        }

        template <typename ForwardIt>
        constexpr void _m_append_range(
            ForwardIt first,
            ForwardIt last,
            std::forward_iterator_tag
        ) noexcept {
            size_type addN = std::distance(first, last);
            if (addN == 0)
                return;

            // Materialize into a scratch buffer only when growth is required;
            // otherwise write straight into the tail of the current buffer.
            size_type oldN = size();
            if (!_m_is_heap() && oldN + addN <= HeapMeta::capacity) {
                size_type i = oldN;
                for (; first != last; ++first, ++i)
                    m_stack.data[i] = *first;
                Tag::set_stack_size(m_stack, oldN + addN);
                m_stack.data[oldN + addN] = value_type{};
                return;
            }

            size_type newN = oldN + addN;
            size_type newCap = _m_is_heap()
                ? std::max(Tag::get_heap_capacity(m_heap) * 2, newN)
                : newN;
            pointer p = m_allocator.allocate(newCap + 1);
            traits_type::copy(p, data(), oldN);
            size_type i = oldN;
            for (; first != last; ++first, ++i)
                p[i] = *first;
            p[newN] = value_type{};

            _m_release();
            m_heap.data = p;
            m_heap.size = newN;
            Tag::set_heap_capacity(m_heap, newCap);
        }

        template <typename InputIt>
        constexpr void _m_append_range(
            InputIt first,
            InputIt last,
            std::input_iterator_tag
        ) noexcept {
            for (; first != last; ++first)
                push_back(*first);
        }

        static constexpr size_type _m_get_grow_size(size_type requested) noexcept {
            return requested < 8 ? 8 : requested + requested / 2;
        }

        constexpr void _m_grow_and_append(const value_type* string, size_type addN) noexcept {
            size_type oldN = size();
            size_type newN = oldN + addN;
            size_type newCap = _m_get_grow_size(newN);

            pointer p = m_allocator.allocate(newCap + 1);
            traits_type::copy(p, data(), oldN);   // must read old buffer before _m_release()
            traits_type::copy(p + oldN, string, addN);
            p[newN] = value_type{};

            _m_release();
            m_heap.data = p;
            m_heap.size = newN;
            Tag::set_heap_capacity(m_heap, newCap);
        }

        constexpr pointer _m_make_gap(size_type index, size_type count) noexcept {
            assert(index <= size() && "basic_string: insert index out of range");
            if (count == 0)
                return data();

            size_type oldN = size();
            size_type newN = oldN + count;

            if (!_m_is_heap() && newN <= StackMeta::capacity) {
                traits_type::move(
                    m_stack.data + index + count,
                    m_stack.data + index,
                    oldN - index
                );
                Tag::set_stack_size(m_stack, newN);
                m_stack.data[newN] = value_type{};
                return m_stack.data;
            }

            if (_m_is_heap() && newN <= Tag::get_heap_capacity(m_heap)) {
                traits_type::move(
                    m_heap.data + index + count,
                    m_heap.data + index,
                    oldN - index
                );
                m_heap.size = newN;
                m_heap.data[newN] = value_type{};
                return m_heap.data;
            }

            size_type newCap = std::max<size_type>(
                _m_is_heap() ? Tag::get_heap_capacity(m_heap) * 2 : StackMeta::capacity * 2,
                newN
            );
            pointer p = m_allocator.allocate(newCap + 1);
            const_pointer old = data();
            traits_type::copy(p, old, index);
            traits_type::copy(p + index + count, old + index, oldN - index);
            p[newN] = value_type{};

            _m_release(); // old fully consumed above; safe to free now
            m_heap.data = p;
            m_heap.size = newN;
            Tag::set_heap_capacity(m_heap, newCap);
            return p;
        }

        constexpr bool _m_aliases(const_pointer string) const noexcept {
            const_pointer b = data();
            const_pointer e = b + capacity() + 1; // +1: include the terminator slot
            return string >= b && string < e;
        }

        constexpr basic_string& _m_insert_impl(
            size_type index,
            const value_type* string,
            size_type count
        ) noexcept {
            if (count == 0)
                return *this;

            if (_m_aliases(string)) {
                pointer scratch = m_allocator.allocate(count);
                traits_type::copy(scratch, string, count);
                pointer base = _m_make_gap(index, count);
                traits_type::copy(base + index, scratch, count);
                m_allocator.deallocate(scratch, count);
            } else {
                pointer base = _m_make_gap(index, count);
                traits_type::copy(base + index, string, count);
            }
            return *this;
        }

        template <typename ForwardIt>
        constexpr iterator _m_insert_range_at(
            size_type index,
            ForwardIt first,
            ForwardIt last,
            std::forward_iterator_tag
        ) noexcept {
            size_type n = std::distance(first, last);
            if (n == 0)
                return data() + index;
            pointer base = _m_make_gap(index, n);
            size_type i = index;
            for (; first != last; ++first, ++i)
                base[i] = *first;
            return base + index;
        }

        template <typename InputIt>
        constexpr iterator _m_insert_range_at(
            size_type index,
            InputIt first,
            InputIt last,
            std::input_iterator_tag
        ) noexcept {
            size_type i = index;
            for (; first != last; ++first, ++i) {
                pointer base = _m_make_gap(i, 1);
                base[i] = *first;
            }
            return data() + index;
        }

        constexpr pointer _m_make_room_at_end(size_type count) noexcept {
            if (count == 0)
                return data();

            size_type oldN = size();
            size_type newN = oldN + count;

            if (!_m_is_heap() && newN <= StackMeta::capacity) {
                Tag::set_stack_size(m_stack, newN);
                m_stack.data[newN] = value_type{};
                return m_stack.data;
            }

            if (_m_is_heap() && newN <= Tag::get_heap_capacity(m_heap)) {
                m_heap.size = newN;
                m_heap.data[newN] = value_type{};
                return m_heap.data;
            }

            size_type newCap = _m_get_grow_size(newN);
            pointer p = m_allocator.allocate(newCap + 1);
            traits_type::copy(p, data(), oldN); // must read old buffer before _m_release()
            p[newN] = value_type{};

            _m_release();
            m_heap.data = p;
            m_heap.size = newN;
            Tag::set_heap_capacity(m_heap, newCap);
            return p;
        }

        constexpr basic_string& _m_append_impl(
            const value_type* string,
            size_type count
        ) noexcept {
            if (count == 0)
                return *this;

            if (_m_aliases(string)) {
                pointer scratch = m_allocator.allocate(count);
                traits_type::copy(scratch, string, count);
                size_type oldN = size();
                pointer base = _m_make_room_at_end(count);
                traits_type::copy(base + oldN, scratch, count);
                m_allocator.deallocate(scratch, count);
            } else {
                size_type oldN = size();
                pointer base = _m_make_room_at_end(count);
                traits_type::copy(base + oldN, string, count);
            }
            return *this;
        }

        constexpr void _m_replace_write(
            size_type pos,
            size_type count,
            const value_type* source,
            size_type srcCount,
            size_type tailLen,
            size_type newN
        ) noexcept {
            if (!_m_is_heap() && newN <= StackMeta::capacity) {
                traits_type::move(m_stack.data + pos + srcCount, m_stack.data + pos + count, tailLen);
                traits_type::copy(m_stack.data + pos, source, srcCount);
                Tag::set_stack_size(m_stack, newN);
                m_stack.data[newN] = value_type{};
                return;
            }

            if (_m_is_heap() && newN <= Tag::get_heap_capacity(m_heap)) {
                traits_type::move(m_heap.data + pos + srcCount, m_heap.data + pos + count, tailLen);
                traits_type::copy(m_heap.data + pos, source, srcCount);
                m_heap.size = newN;
                m_heap.data[newN] = value_type{};
                return;
            }

            size_type newCap = _m_get_grow_size(newN);
            pointer p = m_allocator.allocate(newCap + 1);
            const_pointer old = data();
            traits_type::copy(p, old, pos);
            traits_type::copy(p + pos, source, srcCount);
            traits_type::copy(p + pos + srcCount, old + pos + count, tailLen);
            p[newN] = value_type{};

            _m_release(); // old fully consumed above; safe to free now
            m_heap.data = p;
            m_heap.size = newN;
            Tag::set_heap_capacity(m_heap, newCap);
        }

        constexpr basic_string& _m_replace_impl(
            size_type pos,
            size_type count,
            const value_type* source,
            size_type srcCount
        ) noexcept {
            size_type oldN = size();
            count = std::min(count, oldN - pos);

            if (srcCount == 0)
                return erase(pos, count); // pure deletion, nothing to stage/write

            size_type tailLen = oldN - pos - count;
            size_type newN = oldN - count + srcCount;

            // Self-replace guard: str.replace(pos, count, str) or a slice of
            // it. _m_replace_write may shift/reallocate mid-operation, which
            // would invalidate `source` if it points into *this*.
            if (_m_aliases(source)) {
                pointer scratch = m_allocator.allocate(srcCount);
                traits_type::copy(scratch, source, srcCount);
                _m_replace_write(pos, count, scratch, srcCount, tailLen, newN);
                m_allocator.deallocate(scratch, srcCount);
            } else {
                _m_replace_write(pos, count, source, srcCount, tailLen, newN);
            }
            return *this;
        }

        // ch is by-value, never aliases the buffer — no staging needed.
        constexpr basic_string& _m_replace_fill_impl(
            size_type pos,
            size_type count,
            size_type count2,
            value_type ch
        ) noexcept {
            size_type oldN = size();
            count = std::min(count, oldN - pos);

            if (count2 == 0)
                return erase(pos, count);

            size_type tailLen = oldN - pos - count;
            size_type newN = oldN - count + count2;

            if (!_m_is_heap() && newN <= StackMeta::capacity) {
                traits_type::move(m_stack.data + pos + count2, m_stack.data + pos + count, tailLen);
                traits_type::assign(m_stack.data + pos, count2, ch);
                Tag::set_stack_size(m_stack, newN);
                m_stack.data[newN] = value_type{};
                return *this;
            }
            if (_m_is_heap() && newN <= Tag::get_heap_capacity(m_heap)) {
                traits_type::move(m_heap.data + pos + count2, m_heap.data + pos + count, tailLen);
                traits_type::assign(m_heap.data + pos, count2, ch);
                m_heap.size = newN;
                m_heap.data[newN] = value_type{};
                return *this;
            }

            size_type newCap = _m_get_grow_size(newN);
            pointer p = m_allocator.allocate(newCap + 1);
            const_pointer old = data();
            traits_type::copy(p, old, pos);
            traits_type::assign(p + pos, count2, ch);
            traits_type::copy(p + pos + count2, old + pos + count, tailLen);
            p[newN] = value_type{};

            _m_release();
            m_heap.data = p;
            m_heap.size = newN;
            Tag::set_heap_capacity(m_heap, newCap);
            return *this;
        }

        static constexpr size_type _m_search(
            const value_type* haystack,
            size_type hLen,
            const value_type* needle,
            size_type nLen,
            size_type pos
        ) noexcept {
            if (nLen == 0)
                return pos <= hLen ? pos : npos;
            if (pos > hLen || nLen > hLen - pos)
                return npos;

            size_type last = hLen - nLen;
            for (size_type i = pos; i <= last; ++i) {
                size_type j = 0;
                for (; j < nLen; ++j)
                    if (!traits_type::eq(haystack[i + j], needle[j]))
                        break;
                if (j == nLen)
                    return i;
            }
            return npos;
        }

        static constexpr size_type _m_rsearch(
            const value_type* haystack,
            size_type hLen,
            const value_type* needle,
            size_type nLen,
            size_type pos
        ) noexcept {
            if (nLen == 0)
                return std::min(pos, hLen);
            if (nLen > hLen)
                return npos;

            size_type last = std::min(pos, hLen - nLen);
            for (size_type i = last + 1; i-- > 0; ) {
                size_type j = 0;
                for (; j < nLen; ++j)
                    if (!traits_type::eq(haystack[i + j], needle[j]))
                        break;
                if (j == nLen)
                    return i;
            }
            return npos;
        }

        static constexpr bool _m_in_set(
            const_pointer set,
            size_type setLen,
            value_type ch
        ) noexcept {
            for (size_type i = 0; i < setLen; ++i)
                if (traits_type::eq(set[i], ch))
                    return true;
            return false;
        }

        static constexpr size_type _m_find_first_of_impl(
            const_pointer haystack,
            size_type hLen,
            const_pointer set,
            size_type setLen,
            size_type pos
        ) noexcept {
            for (size_type i = pos; i < hLen; ++i)
                if (_m_in_set(set, setLen, haystack[i]))
                    return i;
            return npos;
        }

        static constexpr size_type _m_find_first_not_of_impl(
            const_pointer haystack,
            size_type hLen,
            const_pointer set,
            size_type setLen,
            size_type pos
        ) noexcept {
            for (size_type i = pos; i < hLen; ++i)
                if (!_m_in_set(set, setLen, haystack[i]))
                    return i;
            return npos;
        }

        static constexpr size_type _m_find_last_of_impl(
            const_pointer haystack,
            size_type hLen,
            const_pointer set,
            size_type setLen,
            size_type pos
        ) noexcept {
            if (hLen == 0)
                return npos;
            size_type last = std::min(pos, hLen - 1);
            for (size_type i = last + 1; i-- > 0; )
                if (_m_in_set(set, setLen, haystack[i]))
                    return i;
            return npos;
        }

        static constexpr size_type _m_find_last_not_of_impl(
            const value_type* haystack,
            size_type hLen,
            const value_type* set,
            size_type setLen,
            size_type pos
        ) noexcept {
            if (hLen == 0)
                return npos;
            size_type last = std::min(pos, hLen - 1);
            for (size_type i = last + 1; i-- > 0; )
                if (!_m_in_set(set, setLen, haystack[i]))
                    return i;
            return npos;
        }

        static constexpr std::strong_ordering _m_compare_impl(
            const value_type* lhs,
            size_type lhsLen,
            const value_type* rhs,
            size_type rhsLen
        ) noexcept {
            size_type rlen = std::min(lhsLen, rhsLen);
            
            int r = traits_type::compare(lhs, rhs, rlen);
            if (r < 0)
                return std::strong_ordering::less;
            if (r > 0)
                return std::strong_ordering::greater;

            if (lhsLen < rhsLen)
                return std::strong_ordering::less;
            if (lhsLen > rhsLen)
                return std::strong_ordering::greater;

            return std::strong_ordering::equal;
        }

#pragma endregion Internal functions
    private:
#pragma region Internal data structures
        struct HeapMeta {
            pointer data;
            size_type size;
            size_type capacity;
        };

        struct StackMeta {
            static constexpr size_type capacity = sizeof(HeapMeta) / sizeof(value_type);
            value_type data[capacity];
        };

        struct Tag {
            static constexpr size_type longFlag  = 1 << 7;
            static constexpr size_type shortFlag = (1 << 7) - 1;
            static constexpr size_type capacityMask = longFlag << ((sizeof(size_type) - 1) * 8);

            static constexpr auto& byte_of(StackMeta& data) noexcept {
                return reinterpret_cast<std::uint8_t*>(data.data)[data.capacity - 1];
            }
            static constexpr auto byte_of(const StackMeta& data) noexcept {
                return reinterpret_cast<const std::uint8_t*>(data.data)[data.capacity - 1];
            }
            static constexpr bool _m_is_heap(const StackMeta& data) noexcept {
                return NOS::Utils::Bits::is_set(byte_of(data), longFlag);
            }
            static constexpr bool is_stack(const StackMeta& data) noexcept {
                return !_m_is_heap(data);
            }
            static constexpr void set_stack_size(StackMeta& data, size_type size) noexcept {
                byte_of(data) = static_cast<std::uint8_t>(data.capacity - size);
            }
            static constexpr void set_heap_capacity(HeapMeta& data, size_type capacity) noexcept {
                data.capacity = capacity | capacityMask;
            }            
            static constexpr auto get_stack_size(const StackMeta& data) noexcept {
                return data.capacity - (byte_of(data) & shortFlag);
            }
            static constexpr auto get_heap_capacity(const HeapMeta& data) noexcept {
                return data.capacity & ~capacityMask;
            }
        };
        constexpr bool _m_is_heap() const noexcept { return Tag::_m_is_heap(m_stack); }

        union {
            HeapMeta m_heap;
            StackMeta m_stack;
        };
        [[no_unique_address]] allocator_type m_allocator;
#pragma endregion Internal data structures
        
        static_assert(
            std::is_trivially_copyable_v<value_type> &&
            std::is_trivially_default_constructible_v<value_type> &&
            std::is_standard_layout_v<value_type>
        );
        
        static_assert(std::is_same_v<value_type, typename traits_type::char_type>);
        static_assert(std::is_same_v<value_type, typename allocator_type::value_type>);
        static_assert(std::is_standard_layout_v<HeapMeta>);
        static_assert(sizeof(HeapMeta) == sizeof(StackMeta));
    };

    namespace detail {        
        template <class CharT, class Traits, class Alloc>
        constexpr basic_string<CharT, Traits, Alloc> concat(
            const CharT* a,
            typename basic_string<CharT, Traits, Alloc>::size_type aLen,
            const CharT* b,
            typename basic_string<CharT, Traits, Alloc>::size_type bLen,
            const Alloc& alloc
        ) noexcept {
            basic_string<CharT, Traits, Alloc> result(alloc);
            result.reserve(aLen + bLen);
            result.append(a, aLen);
            result.append(b, bLen);
            return result;
        }
    }

    template <class CharT, class Traits, class Alloc>
    constexpr basic_string<CharT, Traits, Alloc> operator+(
        const basic_string<CharT, Traits, Alloc>& lhs,
        const basic_string<CharT, Traits, Alloc>& rhs
    ) noexcept {
        return detail::concat<CharT, Traits, Alloc>(
            lhs.data(),
            lhs.size(),
            rhs.data(),
            rhs.size(),
            lhs.get_allocator()
        );
    }

    template <class CharT, class Traits, class Alloc>
    constexpr basic_string<CharT, Traits, Alloc> operator+(
        const basic_string<CharT, Traits, Alloc>& lhs,
        const CharT* rhs
    ) noexcept {
        return detail::concat<CharT, Traits, Alloc>(
            lhs.data(),
            lhs.size(),
            rhs,
            Traits::length(rhs),
            lhs.get_allocator()
        );
    }

    template <class CharT, class Traits, class Alloc>
    constexpr basic_string<CharT, Traits, Alloc> operator+(
        const basic_string<CharT, Traits, Alloc>& lhs,
        CharT rhs
    ) noexcept {
        return detail::concat<CharT, Traits, Alloc>(
            lhs.data(),
            lhs.size(),
            &rhs,
            1,
            lhs.get_allocator()
        );
    }

    template <class CharT, class Traits, class Alloc>
    constexpr basic_string<CharT, Traits, Alloc> operator+(
        const basic_string<CharT, Traits, Alloc>& lhs,
        std::type_identity_t<std::basic_string_view<CharT, Traits>> rhs
    ) noexcept {
        return detail::concat<CharT, Traits, Alloc>(
            lhs.data(),
            lhs.size(),
            rhs.data(),
            static_cast<typename basic_string<CharT,Traits,Alloc>::size_type>(rhs.size()),
            lhs.get_allocator()
        );
    }

    template <class CharT, class Traits, class Alloc>
    constexpr basic_string<CharT, Traits, Alloc> operator+(
        const CharT* lhs,
        const basic_string<CharT, Traits, Alloc>& rhs
    ) noexcept {
        return detail::concat<CharT, Traits, Alloc>(
            lhs,
            Traits::length(lhs),
            rhs.data(),
            rhs.size(),
            rhs.get_allocator()
        );
    }

    template <class CharT, class Traits, class Alloc>
    constexpr basic_string<CharT, Traits, Alloc> operator+(
        CharT lhs,
        const basic_string<CharT, Traits, Alloc>& rhs
    ) noexcept {
        return detail::concat<CharT, Traits, Alloc>(
            &lhs,
            1,
            rhs.data(),
            rhs.size(),
            rhs.get_allocator()
        );
    }

    template <class CharT, class Traits, class Alloc>
    constexpr basic_string<CharT, Traits, Alloc> operator+(
        std::type_identity_t<std::basic_string_view<CharT, Traits>> lhs,
        const basic_string<CharT, Traits, Alloc>& rhs
    ) noexcept {
        return detail::concat<CharT, Traits, Alloc>(
            lhs.data(),
            static_cast<typename basic_string<CharT,Traits,Alloc>::size_type>(lhs.size()),
            rhs.data(),
            rhs.size(),
            rhs.get_allocator()
        );
    }

    // ==================== rvalue lhs: steal lhs's buffer, append rhs ====================

    template <class CharT, class Traits, class Alloc>
    constexpr basic_string<CharT, Traits, Alloc> operator+(
        basic_string<CharT, Traits, Alloc>&& lhs,
        basic_string<CharT, Traits, Alloc>&& rhs
    ) noexcept {
        basic_string<CharT, Traits, Alloc> result(std::move(lhs));
        result.reserve(result.size() + rhs.size());
        result.append(rhs.data(), rhs.size());
        return result;
    }

    template <class CharT, class Traits, class Alloc>
    constexpr basic_string<CharT, Traits, Alloc> operator+(
        basic_string<CharT, Traits, Alloc>&& lhs,
        const basic_string<CharT, Traits, Alloc>& rhs
    ) noexcept {
        basic_string<CharT, Traits, Alloc> result(std::move(lhs));
        result.reserve(result.size() + rhs.size());
        result.append(rhs.data(), rhs.size());
        return result;
    }

    template <class CharT, class Traits, class Alloc>
    constexpr basic_string<CharT, Traits, Alloc> operator+(
        basic_string<CharT, Traits, Alloc>&& lhs,
        const CharT* rhs
    ) noexcept {
        basic_string<CharT, Traits, Alloc> result(std::move(lhs));
        typename basic_string<CharT, Traits, Alloc>::size_type n = Traits::length(rhs);
        result.reserve(result.size() + n);
        result.append(rhs, n);
        return result;
    }

    template <class CharT, class Traits, class Alloc>
    constexpr basic_string<CharT, Traits, Alloc> operator+(
        basic_string<CharT, Traits, Alloc>&& lhs,
        CharT rhs
    ) noexcept {
        basic_string<CharT, Traits, Alloc> result(std::move(lhs));
        result.push_back(rhs);
        return result;
    }

    template <class CharT, class Traits, class Alloc>
    constexpr basic_string<CharT, Traits, Alloc> operator+(
        basic_string<CharT, Traits, Alloc>&& lhs,
        std::type_identity_t<std::basic_string_view<CharT, Traits>> rhs
    ) noexcept {
        basic_string<CharT, Traits, Alloc> result(std::move(lhs));
        auto n = static_cast<typename basic_string<CharT, Traits, Alloc>::size_type>(rhs.size());
        result.reserve(result.size() + n);
        result.append(rhs.data(), n);
        return result;
    }

    // ==================== rvalue rhs: steal rhs's buffer, prepend lhs ====================
    template <class CharT, class Traits, class Alloc>
    constexpr basic_string<CharT, Traits, Alloc> operator+(
        const basic_string<CharT, Traits, Alloc>& lhs,
        basic_string<CharT, Traits, Alloc>&& rhs
    ) noexcept {
        basic_string<CharT, Traits, Alloc> result(std::move(rhs));
        result.reserve(lhs.size() + result.size());
        result.insert(0, lhs.data(), lhs.size());
        return result;
    }

    template <class CharT, class Traits, class Alloc>
    constexpr basic_string<CharT, Traits, Alloc> operator+(
        const CharT* lhs,
        basic_string<CharT, Traits, Alloc>&& rhs
    ) noexcept {
        basic_string<CharT, Traits, Alloc> result(std::move(rhs));
        typename basic_string<CharT, Traits, Alloc>::size_type n = Traits::length(lhs);
        result.reserve(n + result.size());
        result.insert(0, lhs, n);
        return result;
    }

    template <class CharT, class Traits, class Alloc>
    constexpr basic_string<CharT, Traits, Alloc> operator+(
        CharT lhs,
        basic_string<CharT, Traits, Alloc>&& rhs
    ) noexcept {
        basic_string<CharT, Traits, Alloc> result(std::move(rhs));
        result.insert(0, 1, lhs); // single char prepend: insert(index, count, ch)
        return result;
    }

    template <class CharT, class Traits, class Alloc>
    constexpr basic_string<CharT, Traits, Alloc> operator+(
        std::type_identity_t<std::basic_string_view<CharT, Traits>> lhs,
        basic_string<CharT, Traits, Alloc>&& rhs
    ) noexcept {
        basic_string<CharT, Traits, Alloc> result(std::move(rhs));
        auto n = static_cast<typename basic_string<CharT, Traits, Alloc>::size_type>(lhs.size());
        result.reserve(n + result.size());
        result.insert(0, lhs.data(), n);
        return result;
    }

    template <class CharT, class Traits, class Alloc>
    constexpr bool operator==(
        const basic_string<CharT, Traits, Alloc>& lhs,
        const basic_string<CharT, Traits, Alloc>& rhs
    ) noexcept {
        return
            lhs.size() == rhs.size() &&
            Traits::compare(lhs.data(), rhs.data(), lhs.size()) == 0;
    }

    template <class CharT, class Traits, class Alloc>
    constexpr bool operator==(
        const basic_string<CharT, Traits, Alloc>& lhs,
        const CharT* rhs
    ) noexcept {
        return lhs.compare(rhs) == 0;
    }

    // ==================== operator<=> ====================
    template <class CharT, class Traits, class Alloc>
    constexpr detail::comparison_category_t<Traits> operator<=>(
        const basic_string<CharT, Traits, Alloc>& lhs,
        const basic_string<CharT, Traits, Alloc>& rhs
    ) noexcept {
        return static_cast<detail::comparison_category_t<Traits>>(lhs.compare(rhs) <=> 0);
    }

    template <class CharT, class Traits, class Alloc>
    constexpr detail::comparison_category_t<Traits> operator<=>(
        const basic_string<CharT, Traits, Alloc>& lhs,
        const CharT* rhs
    ) noexcept {
        return static_cast<detail::comparison_category_t<Traits>>(lhs.compare(rhs) <=> 0);
    }

    template <class CharT, class Traits, class Alloc>
    constexpr void swap(
        basic_string<CharT, Traits, Alloc>& lhs,
        basic_string<CharT, Traits, Alloc>& rhs
    ) noexcept(noexcept(lhs.swap(rhs))) {
        return lhs.swap(rhs);
    }

    template <class CharT, class Traits, class Alloc, class U = CharT>
    constexpr basic_string<CharT, Traits, Alloc>::size_type erase(
        basic_string<CharT, Traits, Alloc>& string,
        const U& value
    ) noexcept {
        auto it = std::remove(string.begin(), string.end(), value);
        auto r = string.end() - it;
        string.erase(it, string.end());
        return r;
    }

    template <class CharT, class Traits, class Alloc, class Pred>
    constexpr basic_string<CharT, Traits, Alloc>::size_type erase_if(
        basic_string<CharT, Traits, Alloc>& string,
        Pred pred
    ) noexcept {
        auto it = std::remove_if(string.begin(), string.end(), pred);
        auto r = string.end() - it;
        string.erase(it, string.end());
        return r;
    }

    using string = basic_string<char>;
    using wstring = basic_string<wchar_t>;
    using u8string = basic_string<char8_t>;
    using u16string = basic_string<char16_t>;
    using u32string = basic_string<char32_t>;

    namespace detail {
        constexpr std::size_t fnv1a(
            const void* data,
            std::size_t byteLen
        ) noexcept {
            constexpr std::size_t offset_basis = 0x811C9DC5u;
            constexpr std::size_t prime        = 0x01000193u;

            auto* bytes = static_cast<const std::uint8_t*>(data);
            std::size_t h = offset_basis;
            for (std::size_t i = 0; i < byteLen; ++i) {
                h ^= bytes[i];
                h *= prime;
            }
            return h;
        }

        template <class CharT, class Traits, class Alloc>
        constexpr std::size_t hash_basic_string(
            const basic_string<CharT, Traits, Alloc>& str
        ) noexcept {
            return fnv1a(str.data(), str.size() * sizeof(CharT));
        }
    }

    namespace literals::string_literals {
        constexpr klibc::string operator""s(const char* str, std::size_t length) noexcept {
            return klibc::string(str, length);
