            size_type n1 = std::min(count1, size() - pos1);
            size_type n2 = std::min(count2, string.size() - pos2);
            return _m_compare_impl(data() + pos1, n1, string.data() + pos2, n2);
        }

        constexpr int compare(const value_type* string) const noexcept {
            return _m_compare_impl(data(), size(), string, traits_type::length(string));
        }

        constexpr int compare(
            size_type pos1,
            size_type count1,
            const value_type* string
        ) const noexcept {
            assert(pos1 <= size() && "basic_string::compare: pos1 out of range");
            size_type n1 = std::min(count1, size() - pos1);
            return _m_compare_impl(data() + pos1, n1, string, traits_type::length(string));
        }

        constexpr int compare(
            size_type pos1,
            size_type count1,
            const value_type* string,
            size_type count2
        ) const noexcept {
            assert(pos1 <= size() && "basic_string::compare: pos1 out of range");
            size_type n1 = std::min(count1, size() - pos1);
            return _m_compare_impl(data() + pos1, n1, string, count2);
        }

        template <class StringViewLike>
        requires (
            std::is_convertible_v<
                const StringViewLike&,
                std::basic_string_view<value_type, traits_type>
            > &&
            !std::is_convertible_v<const StringViewLike&, const_pointer>
        )
        constexpr int compare(const StringViewLike& string) const
            noexcept(std::is_nothrow_convertible_v<
                const StringViewLike&,
                std::basic_string_view<value_type, traits_type>
            >)
        {
            std::basic_string_view<value_type, traits_type> view = string;
            return _m_compare_impl(
                data(),
                size(),
                view.data(),
                static_cast<size_type>(view.size())
            );
        }

        template <class StringViewLike>
        requires (
            std::is_convertible_v<
                const StringViewLike&,
                std::basic_string_view<value_type, traits_type>
            > &&
            !std::is_convertible_v<const StringViewLike&, const_pointer>
        )
        constexpr int compare(
            size_type pos1,
            size_type count1,
            const StringViewLike& string
        ) const noexcept {
            assert(pos1 <= size() && "basic_string::compare: pos1 out of range");
            size_type n1 = std::min(count1, size() - pos1);
            std::basic_string_view<value_type, traits_type> view = string;
            return _m_compare_impl(
                data() + pos1,
                n1,
                view.data(),
                static_cast<size_type>(view.size())
            );
        }

        template <class StringViewLike>
        requires (
            std::is_convertible_v<
                const StringViewLike&,
                std::basic_string_view<value_type, traits_type>
            > &&
            !std::is_convertible_v<const StringViewLike&, const_pointer>
        )
        constexpr int compare(
            size_type pos1,
            size_type count1,
            const StringViewLike& string,
            size_type pos2,
            size_type count2 = npos
        ) const noexcept {
            assert(pos1 <= size() && "basic_string::compare: pos1 out of range");
            std::basic_string_view<value_type, traits_type> view = string;
            assert(pos2 <= view.size() && "basic_string::compare: pos2 out of range");
            size_type n1 = std::min(count1, size() - pos1);
            size_type n2 = std::min(count2, view.size() - pos2);
            return _m_compare_impl(data() + pos1, n1, view.data() + pos2, n2);
        }

        // ==================== starts_with ====================
        constexpr bool starts_with(
            std::basic_string_view<value_type, traits_type> view
        ) const noexcept {
            size_type n = view.size();
            return size() >= n && traits_type::compare(data(), view.data(), n) == 0;
        }
        constexpr bool starts_with(value_type ch) const noexcept {
            return !empty() && traits_type::eq(front(), ch);
        }
        constexpr bool starts_with(const value_type* string) const noexcept {
            return starts_with(std::basic_string_view<value_type, traits_type>(string));
        }

        // ==================== ends_with ====================
        constexpr bool ends_with(
            std::basic_string_view<value_type, traits_type> view
        ) const noexcept {
            size_type n = static_cast<size_type>(view.size());
            return
            size() >= n &&
                traits_type::compare(data() + size() - n, view.data(), n) == 0;
        }
        constexpr bool ends_with(value_type ch) const noexcept {
            return !empty() && traits_type::eq(back(), ch);
        }
        constexpr bool ends_with(const value_type* string) const noexcept {
            return ends_with(
                std::basic_string_view<value_type, traits_type>(string)
            );
        }

        // ==================== contains ====================
        constexpr bool contains(
            std::basic_string_view<value_type, traits_type> view
        ) const noexcept {
            return _m_search(
                data(),
                size(),
                view.data(),
                static_cast<size_type>(view.size()), 0
            ) != npos;
        }
        constexpr bool contains(value_type ch) const noexcept {
            return find(ch) != npos;
        }
        constexpr bool contains(const value_type* string) const noexcept {
            return contains(std::basic_string_view<value_type, traits_type>(string));
        }

        constexpr basic_string substr(
            size_type pos = 0,
            size_type count = npos
        ) const& noexcept {
            return basic_string(*this, pos, count, get_allocator());
        }

        constexpr basic_string substr(
            size_type pos = 0,
            size_type count = npos
        ) && noexcept {
            return basic_string(std::move(*this), pos, count, get_allocator());
        }
        constexpr std::basic_string_view<value_type, traits_type> subview(
            size_type pos = 0,
            size_type count = npos
        ) const noexcept {
            assert(pos <= size() && "basic_string::subview: pos out of range");
            return std::basic_string_view<value_type, traits_type>(
                data() + pos,
                std::min(count, size() - pos)
            );
        }
