#pragma once

#include <core/init.hpp>

#include <klibc/cstring>
#include <klibc/memory>
#include <klibc/cassert>

#include <iterator>
#include <algorithm>

namespace klibc {
    template <typename T, std::size_t N>
    struct inplace_vector {
        using value_type             = T;
        using size_type              = std::size_t;
        using difference_type        = std::ptrdiff_t;
        using reference              = value_type&;
        using const_reference        = const value_type&;
        using rvalue_reference       = value_type&&;
        using pointer                = value_type*;
        using const_pointer          = const value_type*;
        using iterator               = value_type*;
        using const_iterator         = const value_type*;
        using reverse_iterator       = std::reverse_iterator<iterator>;
        using const_reverse_iterator = std::reverse_iterator<const_iterator>;

        constexpr inplace_vector() noexcept = default;

        constexpr explicit inplace_vector(size_type count) noexcept :
            m_size(count)
        {
            assert(count <= N && "Count exceeds capacity");
            for (size_type i = 0; i < m_size; ++i) {
                klibc::construct_at(data() + i);
            }
        }

        constexpr inplace_vector(size_type count, const_reference value) noexcept :
            m_size(count)
        {
            assert(count <= N && "Count exceeds capacity");
            for (size_type i = 0; i < m_size; ++i) {
                klibc::construct_at(data() + i, value);
            }
        }

        template <typename InputIt>
        constexpr inplace_vector(InputIt first, InputIt last) noexcept :
            m_size(0)
        {
            for (; first != last && m_size < N; ++first) {
                klibc::construct_at(data() + m_size, *first);
                ++m_size;
            }
        }


        constexpr ~inplace_vector() noexcept {
            for (size_type i = 0; i < m_size; ++i) {
                klibc::destroy_at(data() + i);
            }
        }

        constexpr inplace_vector& operator=(const inplace_vector& other) noexcept {
            if (this == &other)
                return *this;

            const size_type common = std::min(m_size, other.m_size);

            // Assign elements that already exist.
            for (size_type i = 0; i < common; ++i)
                at(i) = other[i];

            // Destroy elements that no longer exist.
            for (size_type i = common; i < m_size; ++i)
                klibc::destroy_at(data() + i);

            // Construct newly needed elements.
            for (size_type i = common; i < other.m_size; ++i)
                klibc::construct_at(data() + i, other[i]);

            m_size = other.m_size;
            return *this;
        }

        constexpr inplace_vector& operator=(inplace_vector&& other) noexcept {
            if (this == &other)
                return *this;

            const size_type common = std::min(m_size, other.m_size);

            // Move-assign elements that already exist.
            for (size_type i = 0; i < common; ++i)
                at(i) = std::move(other[i]);

            // Destroy elements that no longer exist.
            for (size_type i = common; i < m_size; ++i)
                klibc::destroy_at(data() + i);

            // Move-construct newly needed elements.
            for (size_type i = common; i < other.m_size; ++i)
                klibc::construct_at(data() + i, std::move(other[i]));

            m_size = other.m_size;
            return *this;
        }
        
        constexpr inplace_vector& operator=(std::initializer_list<T> init) {
            const size_type common = std::min(m_size, init.size());

            auto first = init.begin();

            // Assign elements that already exist.
            for (size_type i = 0; i < common; ++i, ++first)
                at(i) = *first;

            // Destroy excess elements.
            for (size_type i = common; i < m_size; ++i)
                klibc::destroy_at(data() + i);

            // Construct additional elements.
            for (size_type i = common; i < init.size(); ++i, ++first)
                klibc::construct_at(data() + i, *first);

            m_size = init.size();
            return *this;
        }


        constexpr pointer data() noexcept {
            return std::launder(reinterpret_cast<pointer>(m_data));
        }

        constexpr const_pointer data() const noexcept {
            return std::launder(reinterpret_cast<const_pointer>(m_data));
        }

        constexpr reference at(size_type index) noexcept {
            assert(index < m_size && "Index out of bounds");
            return data()[index];
        }

        constexpr const_reference at(size_type index) const noexcept {
            assert(index < m_size && "Index out of bounds");
            return data()[index];
        }

        constexpr reference operator[](size_type index) noexcept {
            return data()[index];
        }
        
        constexpr const_reference operator[](size_type index) const noexcept {
            return data()[index];
        }

        constexpr bool empty() const noexcept { return m_size == 0; }

        constexpr reference front() noexcept {
            assert(!empty() && "Cannot access front of an empty vector");
            return at(0);
        }
        constexpr const_reference front() const noexcept {
            assert(!empty() && "Cannot access front of an empty vector");
            return at(0);
        }

        constexpr reference back() noexcept {
            assert(!empty() && "Cannot access back of an empty vector");
            return at(m_size - 1);
        }
        constexpr const_reference back() const noexcept {
            assert(!empty() && "Cannot access back of an empty vector");
            return at(m_size - 1);
        }

        constexpr iterator begin() noexcept { return data(); }
        constexpr const_iterator begin() const noexcept { return data(); }
        constexpr const_iterator cbegin() const noexcept { return begin(); }

        constexpr iterator end() noexcept { return data() + m_size; }
        constexpr const_iterator end() const noexcept { return data() + m_size; }
        constexpr const_iterator cend() const noexcept { return end(); }

        constexpr reverse_iterator rbegin() noexcept {
            return reverse_iterator(end());
        }

        constexpr const_reverse_iterator rbegin() const noexcept {
            return const_reverse_iterator(end());
        }

        constexpr const_reverse_iterator crbegin() const noexcept {
            return rbegin();
        }

        constexpr reverse_iterator rend() noexcept {
            return reverse_iterator(begin());
        }

        constexpr const_reverse_iterator rend() const noexcept {
            return const_reverse_iterator(begin());
        }

        constexpr const_reverse_iterator crend() const noexcept {
            return rend();
        }

        constexpr size_type size() const noexcept { return m_size; }
        static constexpr size_type capacity() noexcept { return N; }
        static constexpr size_type max_size() noexcept { return N; }

        constexpr void resize(size_type count) noexcept {
            assert(count <= N && "Resize count exceeds capacity");

            if (count < m_size) {
                for (size_type i = count; i < m_size; ++i)
                    klibc::destroy_at(data() + i);

                m_size = count;
            } else {
                while (m_size < count) {
                    klibc::construct_at(data() + m_size);
                    ++m_size;
                }
            }
        }

        constexpr void resize(size_type count, const T& value) noexcept {
            assert(count <= N && "Resize count exceeds capacity");

            if (count < m_size) {
                for (size_type i = count; i < m_size; ++i)
                    klibc::destroy_at(data() + i);
            } else if (count > m_size) {
                for (size_type i = m_size; i < count; ++i)
                    klibc::construct_at(data() + i, value);
            }

            m_size = count;
        }

        // Does nothing to be compatible with vector
        static constexpr void shrink_to_fit() noexcept {}

        template <typename... Args>
        constexpr iterator emplace(const_iterator pos, Args&&... args) noexcept {
            assert(pos >= cbegin() && pos <= cend() && "out of bounds emplace");
            assert(m_size < N && "inplace_vector is full");

            const size_type index = pos - cbegin();

            // pos == end()
            if (index == m_size) {
                klibc::construct_at(
                    data() + m_size,
                    std::forward<Args>(args)...
                );
                ++m_size;
                return data() + index;
            }

            // pos < m_size
            klibc::construct_at(
                data() + m_size,
                std::move(this[m_size - 1])
            );

            // Shift the initialized elements right.
            for (size_type i = m_size - 1; i > index; --i) {
                this[i] = std::move(this[i - 1]);
            }

            std::destroy_at(data() + index);
            std::construct_at(
                data() + index,
                std::forward<Args>(args)...
            );

            ++m_size;
            return data() + index;
        }

        template <typename... Args>
        constexpr reference emplace_back(Args&&... args) noexcept {
            assert(m_size < N && "inplace_vector is full");

            pointer p = data() + m_size;
            klibc::construct_at(p, std::forward<Args>(args)...);
            ++m_size;

            return *p;
        }

        constexpr void push_back(const_reference value) noexcept {
            emplace_back(value);
        }
        constexpr void push_back(rvalue_reference value) noexcept {
            emplace_back(std::move(value));
        }

        constexpr void pop_back() noexcept {
            assert(m_size > 0 && "inplace_vector is empty");

            --m_size;
            klibc::destroy_at(data() + m_size);
        }

        constexpr iterator insert(const_iterator pos, const_reference value) noexcept {
            return emplace(pos, value);
        }

        constexpr iterator insert(const_iterator pos, rvalue_reference value) noexcept {
            return emplace(pos, std::move(value));
        }
        
        template <typename ForwardIt>
        constexpr iterator insert_range(
            const_iterator pos,
            ForwardIt first,
            ForwardIt last
        ) noexcept {
            const size_type index = pos - cbegin();
            const size_type count = std::distance(first, last);

            assert(index <= m_size && "insert position out of bounds");
            assert(m_size + count <= N && "insert_range exceeds capacity");

            if (count == 0)
                return data() + index;

            // If the range belongs to this vector, make a copy first.
            if constexpr (
                std::is_same_v<ForwardIt, iterator> ||
                std::is_same_v<ForwardIt, const_iterator>
            ) {
                const size_type first_index = first - cbegin();
                const size_type last_index = last - cbegin();

                assert(first_index <= last_index && "invalid range");
                assert(last_index <= m_size && "range out of bounds");

                inplace_vector<T, N> temp;

                for (size_type i = first_index; i < last_index; ++i)
                    temp.emplace_back(data()[i]);

                return insert_range(
                    cbegin() + index,
                    temp.cbegin(),
                    temp.cend()
                );
            }

            const size_type old_size = m_size;
            const size_type tail = old_size - index;

            // move the tail into the uninitialized portion.
            for (size_type i = 0; i < std::min(tail, count); ++i) {
                const size_type src = old_size - 1 - i;
                const size_type dst = old_size + count - 1 - i;

                std::construct_at(
                    data() + dst,
                    std::move(this[src])
                );
            }

            // Move the remaining initialized tail backwards.
            if (tail > count) {
                for (size_type i = old_size - count; i > index; --i) {
                    this[i + count - 1] = std::move(this[i - 1]);
                }
            }

            // fill the gap.
            size_type out = index;

            for (; first != last; ++first, ++out) {
                if (out < old_size) {
                    this[out] = *first;
                } else {
                    std::construct_at(
                        data() + out,
                        *first
                    );
                }
            }

            m_size = old_size + count;
            return data() + index;
        }

    private:
        alignas(value_type) std::byte m_data[
            sizeof(value_type) * N == 0 ? 1 : sizeof(value_type) * N
        ];
        std::size_t m_size = 0;
    };
}